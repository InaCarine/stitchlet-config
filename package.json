{
  "name": "stitchlet-config",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint --continue",
    "lint:css": "turbo run lint:css --continue",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,css,scss,json,yml,yaml,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,css,scss,json,yml,yaml,html}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf pnpm-lock.yaml"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/config-pnpm-scopes": "^20.1.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.7.4",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=v22"
  },
  "overrides": {
    "glob": "^10.5.0"
  }
}
